generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PokemonType {
  NORMAL
  FIRE
  WATER
  GRASS
  ELECTRIC
  ICE
  FIGHTING
  POISON
  GROUND
  FLYING
  PSYCHIC
  BUG
  ROCK
  GHOST
  DRAGON
  STEEL
  FAIRY
  DARK
}

model Pokemon {
  id            String       @id
  name          String       @unique
  primaryType   PokemonType
  secondaryType PokemonType?
  hp            Int
  attack        Int?         @default(50)
  defense       Int?         @default(50)
  speed         Int?         @default(50)
  height        Int?
  weight        Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  captures      Capture[]

  @@map("pokemons")
}

model Trainer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  region    String?   @default("Kanto")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  captures  Capture[]

  @@map("trainers")
}

model Capture {
  id         String   @id @default(uuid())
  trainerId  String
  pokemonId  String
  nickname   String?
  level      Int      @default(5)
  isShiny    Boolean  @default(false)
  capturedAt DateTime @default(now())

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@map("captures")
}
